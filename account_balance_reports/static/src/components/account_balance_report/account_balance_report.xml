<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_balance_reports.AccountBalanceReportAction">
        <div class="o_abr_report h-100 d-flex flex-column">
            <div class="o_abr_control_panel border-bottom bg-view px-3 py-2">
                <div class="d-flex flex-wrap align-items-center gap-2 justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group">
                            <button class="btn btn-secondary" t-on-click="exportPdf">PDF</button>
                            <button class="btn btn-secondary" t-on-click="exportXlsx">XLSX</button>
                        </div>
                        <h2 class="m-0 ms-2" t-esc="state.reportName"/>
                    </div>
                    <span class="badge text-bg-light border" t-esc="currencyLabel"/>
                </div>

                <div class="o_abr_filters d-flex flex-wrap gap-2 mt-2 align-items-center">
                    <div t-if="state.options.search_bar" class="o_abr_search">
                        <input type="text" class="form-control form-control-sm"
                               t-att-placeholder="'Search...'"
                               t-att-value="state.options.search_value or ''"
                               t-on-input="onSearchInput"
                               t-on-keydown="onSearchKeydown"/>
                    </div>

                    <select class="form-select form-select-sm o_abr_filter_btn" t-on-change="onDateFilterChange">
                        <t t-foreach="dateFilters" t-as="df" t-key="df.value">
                            <option t-att-value="df.value"
                                    t-att-selected="state.options.date_filter === df.value"
                                    t-esc="df.label"/>
                        </t>
                    </select>

                    <input t-if="state.options.filter_date_range" type="date"
                           class="form-control form-control-sm o_abr_filter_btn"
                           t-att-value="state.options.date_from"
                           t-on-change="onDateFromChange"/>
                    <input type="date" class="form-control form-control-sm o_abr_filter_btn"
                           t-att-value="state.options.date_to"
                           t-on-change="onDateToChange"/>

                    <select t-if="state.options.filter_period_comparison"
                            class="form-select form-select-sm o_abr_filter_btn"
                            t-on-change="onComparisonFilterChange">
                        <option value="no_comparison" t-att-selected="(state.options.comparison and state.options.comparison.filter) === 'no_comparison'">% Comparison</option>
                        <option value="same_last_period" t-att-selected="(state.options.comparison and state.options.comparison.filter) === 'same_last_period'">Previous Period</option>
                        <option value="same_last_year" t-att-selected="(state.options.comparison and state.options.comparison.filter) === 'same_last_year'">Same Period Last Year</option>
                    </select>

                    <div t-if="state.options.filter_journals" class="dropdown o_abr_filter_dropdown">
                        <button class="btn btn-light btn-sm dropdown-toggle" type="button"
                                t-on-click="() => state.showJournalDropdown = !state.showJournalDropdown">
                            <i class="fa fa-book me-1"/><t t-esc="journalLabel"/>
                        </button>
                        <div t-if="state.showJournalDropdown" class="o_abr_dropdown_menu shadow border bg-white p-2">
                            <t t-foreach="state.options.available_journals or []" t-as="j" t-key="j.id">
                                <label class="d-block mb-1">
                                    <input type="checkbox"
                                           t-att-checked="(state.options.journal_ids or []).includes(j.id)"
                                           t-on-change="() => this.toggleJournal(j.id)"/>
                                    <span class="ms-1" t-esc="j.name"/>
                                </label>
                            </t>
                        </div>
                    </div>

                    <div t-if="state.options.filter_analytic" class="dropdown o_abr_filter_dropdown">
                        <button class="btn btn-light btn-sm dropdown-toggle" type="button"
                                t-on-click="() => state.showAnalyticDropdown = !state.showAnalyticDropdown">
                            <i class="fa fa-filter me-1"/>Analytic
                        </button>
                        <div t-if="state.showAnalyticDropdown" class="o_abr_dropdown_menu shadow border bg-white p-2">
                            <t t-foreach="state.options.available_analytic_accounts or []" t-as="a" t-key="a.id">
                                <label class="d-block mb-1">
                                    <input type="checkbox"
                                           t-att-checked="(state.options.analytic_account_ids or []).includes(a.id)"
                                           t-on-change="() => this.toggleAnalytic(a.id)"/>
                                    <span class="ms-1" t-esc="a.name"/>
                                </label>
                            </t>
                        </div>
                    </div>

                    <div t-if="state.options.multi_company" class="dropdown o_abr_filter_dropdown">
                        <button class="btn btn-light btn-sm dropdown-toggle" type="button"
                                t-on-click="() => state.showCompanyDropdown = !state.showCompanyDropdown">
                            Companies
                        </button>
                        <div t-if="state.showCompanyDropdown" class="o_abr_dropdown_menu shadow border bg-white p-2">
                            <t t-foreach="state.options.available_companies or []" t-as="c" t-key="c.id">
                                <label class="d-block mb-1">
                                    <input type="checkbox"
                                           t-att-checked="(state.options.company_ids or []).includes(c.id)"
                                           t-on-change="() => this.toggleCompany(c.id)"/>
                                    <span class="ms-1" t-esc="c.name"/>
                                </label>
                            </t>
                        </div>
                    </div>

                    <button class="btn btn-light btn-sm" t-on-click="toggleAllEntries" t-esc="postedLabel"/>

                    <label t-if="state.options.filter_hierarchy !== 'disabled' and state.handler === 'trial_balance'" class="form-check form-check-inline mb-0 ms-1">
                        <input class="form-check-input" type="checkbox" t-att-checked="state.options.hierarchy" t-on-change="onHierarchyChange"/>
                        <span class="form-check-label">Hierarchy</span>
                    </label>
                    <label t-if="state.options.filter_hide_0_lines !== 'never'" class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" t-att-checked="state.options.hide_zero_lines" t-on-change="onHideZeroChange"/>
                        <span class="form-check-label">Hide zeros</span>
                    </label>
                    <label t-if="state.options.filter_unfold_all" class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" t-att-checked="state.options.unfold_all" t-on-change="onUnfoldAllChange"/>
                        <span class="form-check-label">Unfold all</span>
                    </label>
                </div>
            </div>

            <div class="o_abr_body flex-grow-1 overflow-auto p-3">
                <t t-foreach="state.warnings" t-as="warning" t-key="warning_index">
                    <div class="alert alert-info py-2 mb-2" t-esc="warning.message"/>
                </t>
                <div t-if="state.loading" class="text-muted">Loading…</div>
                <t t-else="">
                    <div t-if="state.options.horizontal_split" class="row g-3">
                        <div class="col-lg-6">
                            <t t-call="account_balance_reports.ReportTable">
                                <t t-set="tableLines" t-value="leftLines"/>
                            </t>
                        </div>
                        <div class="col-lg-6">
                            <t t-call="account_balance_reports.ReportTable">
                                <t t-set="tableLines" t-value="rightLines"/>
                            </t>
                        </div>
                    </div>
                    <div t-else="">
                        <t t-call="account_balance_reports.ReportTable">
                            <t t-set="tableLines" t-value="visibleLines"/>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <t t-name="account_balance_reports.ReportTable">
        <div class="table-responsive o_abr_table_wrapper">
            <table class="table table-sm table-hover o_abr_table mb-0">
                <thead>
                    <tr>
                        <th rowspan="2" class="o_abr_name_col">Account</th>
                        <t t-foreach="columnGroups" t-as="group" t-key="group.name">
                            <th t-att-colspan="group.columns.length" class="text-center border-start o_abr_group_header"
                                t-esc="group.name"/>
                        </t>
                    </tr>
                    <tr>
                        <t t-foreach="state.options.columns or []" t-as="col" t-key="col.key">
                            <th class="text-end border-start" t-esc="col.name"/>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="tableLines" t-as="line" t-key="line.id">
                        <tr t-att-class="line.class">
                            <td>
                                <span t-att-style="'padding-left:' + linePadding(line)">
                                    <button t-if="line.unfoldable"
                                            class="btn btn-link btn-sm p-0 me-1"
                                            t-on-click="() => this.toggleLine(line)">
                                        <i t-att-class="(state.options.unfolded_lines or []).includes(line.id) or state.options.unfold_all ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                    </button>
                                    <span t-esc="line.name"/>
                                </span>
                            </td>
                            <t t-foreach="line.columns or []" t-as="col" t-key="col.key">
                                <td t-attf-class="text-end border-start font-monospace o_abr_amount #{isZero(col.no_format) ? 'text-muted' : ''}"
                                    t-att-title="'Open journal items'"
                                    t-on-click="() => this.openJournalItems(line, col.key)">
                                    <t t-esc="formatValue(col.no_format)"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>
